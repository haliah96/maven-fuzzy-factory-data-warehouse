  <step>
    <name>Table input</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>maven_dwh</connection>
    <sql>SELECT
    o.order_id,
    DATE(o.created_at) AS order_date,
    o.primary_product_id AS product_id,
    o.items_purchased,
    o.price_usd,
    o.cogs_usd,
    CASE WHEN ws.utm_source = 'NULL' OR ws.utm_source IS NULL 
         THEN 'direct' ELSE ws.utm_source END AS utm_source,
    CASE WHEN ws.utm_campaign = 'NULL' OR ws.utm_campaign IS NULL 
         THEN 'none' ELSE ws.utm_campaign END AS utm_campaign,
    CASE WHEN ws.utm_content = 'NULL' OR ws.utm_content IS NULL 
         THEN 'none' ELSE ws.utm_content END AS utm_content,
    CASE WHEN ws.device_type = 'NULL' OR ws.device_type IS NULL 
         THEN 'unknown' ELSE ws.device_type END AS device_type,
    CASE WHEN ws.http_referer = 'NULL' OR ws.http_referer IS NULL 
         THEN 'none' ELSE ws.http_referer END AS http_referer
FROM staging.orders o
LEFT JOIN staging.website_sessions ws 
    ON o.website_session_id = ws.website_session_id;</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
